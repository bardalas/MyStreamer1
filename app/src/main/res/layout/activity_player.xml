<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Live TV: channel name shown briefly after switching -->
    <TextView
        android:id="@+id/osd"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="20dp"
        android:background="#B3000000" android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        android:textColor="#FFFFFF" android:textSize="20sp" android:visibility="gone" />

    <!-- Live TV: channel up / down, shown together with the player controls -->
    <LinearLayout
        android:id="@+id/zap"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
        android:orientation="vertical" android:visibility="gone">
        <Button
            android:id="@+id/chUp" android:layout_width="64dp" android:layout_height="64dp"
            android:text="▲" android:textSize="22sp" android:contentDescription="ערוץ קודם" />
        <Button
            android:id="@+id/chDown" android:layout_width="64dp" android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="▼" android:textSize="22sp" android:contentDescription="ערוץ הבא" />
    </LinearLayout>

    <!-- Playback failed: what happened, and what the viewer can do about it -->
    <LinearLayout
        android:id="@+id/errbox"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:background="#E6000000" android:padding="28dp" android:layoutDirection="rtl"
        android:visibility="gone">
        <TextView
            android:id="@+id/errTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/errWhy"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxWidth="560dp"
            android:textColor="#AAB0BD" android:textSize="15sp" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:orientation="horizontal">
            <Button
                android:id="@+id/errRetry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="נסה שוב" android:textSize="17sp" />
            <Button
                android:id="@+id/errNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="הערוץ הבא" android:textSize="17sp" />
            <Button
                android:id="@+id/errBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="חזרה" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live TV: the info banner. Rises on every channel change and on Up/Down or OK: which channel, what is
         on now with how far along it is, and what follows. Up/Down page through the channels in it. -->
    <LinearLayout
        android:id="@+id/infobar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#E6070910" android:paddingHorizontal="26dp" android:paddingVertical="14dp"
        android:layoutDirection="rtl" android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:id="@+id/chNum"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="46dp" android:gravity="center"
                android:background="#F0B429" android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                android:textColor="#14161F" android:textSize="20sp" android:textStyle="bold" />
            <ImageView
                android:id="@+id/chLogo"
                android:layout_width="64dp" android:layout_height="40dp"
                android:layout_marginStart="14dp" android:scaleType="fitCenter"
                android:contentDescription="@null" android:visibility="gone" />
            <TextView
                android:id="@+id/chName"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:maxLines="1" android:ellipsize="end"
                android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/nowClock"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#AAB0BD" android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="19sp" />

        <ProgressBar
            android:id="@+id/nowBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="8dp" android:max="100"
            android:progressTint="#F0B429" android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/nextTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end"
            android:textColor="#AAB0BD" android:textSize="16sp" />

        <TextView
            android:id="@+id/infoNow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#5F6875" android:textSize="12sp" />
    </LinearLayout>

    <!-- Live TV: the channel list, floating over the picture (long press OK). -->
    <FrameLayout
        android:id="@+id/chPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99000000" android:visibility="gone">
        <ListView
            android:id="@+id/chList"
            android:layout_width="380dp" android:layout_height="match_parent"
            android:layout_gravity="start" android:layoutDirection="rtl"
            android:background="#F2070910" android:divider="#1FFFFFFF" android:dividerHeight="1dp"
            android:listSelector="#33F0B429" android:scrollbars="none"
            android:paddingVertical="10dp" android:clipToPadding="false" />
    </FrameLayout>
</FrameLayout>
